libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: @TARGET@
Description: Interface library for yggdrasil integrations
Version: @PROJECT_VERSION@
URL: https://github.com/langmm/yggcpp
Libs: -L${libdir} -l@TARGET@ @TARGET_LINK_LIBRARIES@
Cflags: -I${includedir} @TARGET_COMPILE_OPTIONS@