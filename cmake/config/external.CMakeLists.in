cmake_minimum_required(VERSION @CMAKE_MINIMUM_REQUIRED_VERSION@)
list(APPEND CMAKE_MODULE_PATH "@CMAKE_CURRENT_FUNCTION_LIST_DIR@")
include(GeneralTools)
include(AddTargetsFromFile)
set(OUTPUT_EXTENSION_OVERRIDE "@OUTPUT_EXTENSION_OVERRIDE@")
message(STATUS "OUTPUT_EXTENSION_OVERRIDE = ${OUTPUT_EXTENSION_OVERRIDE} [EXTERNAL]")
if(OUTPUT_EXTENSION_OVERRIDE)
  set(CMAKE_USER_MAKE_RULES_OVERRIDE ${CMAKE_CURRENT_SOURCE_DIR}/external_ext_overrides.cmake)
  set(CMAKE_@ARGS_LANGUAGE@_OUTPUT_EXTENSION "${OUTPUT_EXTENSION_OVERRIDE}")
endif()

show_build_info(PREFIX "EXTERNAL @target@: ")
project(@target@_PROJECT LANGUAGES @ARGS_LANGUAGE@ @ARGS_LINKER_LANGUAGE@)
show_build_info(PREFIX "EXTERNAL @target@: ")
set(INTERNAL_TOP_BUILD_DIR "@INTERNAL_TOP_BUILD_DIR@")
set(INTERNAL_TOP_SOURCE_DIR "@INTERNAL_TOP_SOURCE_DIR@")
if(NOT INTERNAL_TOP_BUILD_DIR)
  set(INTERNAL_TOP_BUILD_DIR "@CMAKE_BINARY_DIR@")
endif()
if(NOT INTERNAL_TOP_SOURCE_DIR)
  set(INTERNAL_TOP_SOURCE_DIR "@CMAKE_SOURCE_DIR@")
endif()
set(INTERNAL_BUILD_DIR "@CMAKE_CURRENT_BINARY_DIR@")
set(INTERNAL_SOURCE_DIR "@CMAKE_CURRENT_SOURCE_DIR@")
set(target @target@)
set(library_type @library_type@)
set(final_library_type @final_library_type@)
set(internal_target_file "@internal_target_file@")
set(internal_target_export_file "@internal_target_export_file@")
set(external_target_export_file "@external_target_export_file@")
set(external_def_file "@external_def_file@")
message(STATUS "CMAKE_@ARGS_LANGUAGE@_OUTPUT_EXTENSION = ${CMAKE_@ARGS_LANGUAGE@_OUTPUT_EXTENSION}")
message(STATUS "CMAKE_@ARGS_LANGUAGE@_INTERNAL_OUTPUT_EXTENSION = ${CMAKE_@ARGS_LANGUAGE@_INTERNAL_OUTPUT_EXTENSION}")

if(internal_target_export_file)
  import_targets_from_file(
    "${internal_target_export_file}" IMPORTED_TARGETS internal_targets
  )
  message(DEBUG "EXTERNAL ${target}: internal_targets = ${internal_targets} (from ${internal_target_export_file})")
endif()

include(BuildTools)
add_internal_library(
  ${target} ${final_library_type}
  LANGUAGE @ARGS_LANGUAGE@
  LINKER_LANGUAGE @ARGS_LINKER_LANGUAGE@
  SOURCES @EXTERNAL_SOURCES@
  LIBRARIES @ARGS_LIBRARIES@
  INCLUDES @ARGS_INCLUDES@
  DEFINITIONS @ARGS_DEFINITIONS@
  COMPILE_FLAGS @ARGS_COMPILE_FLAGS@
  PROPERTIES @ARGS_PROPERTIES@
  TARGETS_FILE ${internal_target_file}
)

inspect_target(${target} PREFIX "EXTERNAL ${target}: ")

if(library_type STREQUAL "OBJECT")

  get_implicit_libraries(
    @ARGS_LANGUAGE@ implicit_libs
    LANGUAGE_ONLY FULL_LIBRARIES
  )
  target_link_libraries(${target} PUBLIC ${implicit_libs})

  # Ensure that the object files are in the build directory
  copy_target_files(
    ${target} "${CMAKE_CURRENT_BINARY_DIR}"
    TARGET_LANGUAGE @ARGS_LANGUAGE@
    TARGET_TYPE ${final_library_type}
    # OBJECT_EXT ${CMAKE_@ARGS_LANGUAGE@_INTERNAL_OUTPUT_EXTENSION}
    COMPONENTS OBJECTS
  )
  
  # Create .def file for objects
  if(WIN32)
    include(CreateMSVCLib)
    target2def(${target} OUTPUT DEF_FILE)
    set_property(
      TARGET ${target} PROPERTY
      MSVC_DEF_FILE "${DEF_FILE}"
    )
    target_link_options(${target} PUBLIC "/DEF:${DEF_FILE}")
  endif()

endif()

if(external_target_export_file)
  export_targets_to_file(
    "${external_target_export_file}" TARGETS ${target}
  )
endif()