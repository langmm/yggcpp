list(APPEND CMAKE_MODULE_PATH "@CMAKE_CURRENT_FUNCTION_LIST_DIR@")
set(MODULE "@ARGS_MODULE@")
set(FUNCTION "@ARGS_FUNCTION@")
set(ARGUMENTS @ARGS_ARGUMENTS@)
set(IDSTR "@ARGS_IDSTR@")
set(INTERNAL_TOP_BUILD_DIR "@INTERNAL_TOP_BUILD_DIR@")
set(INTERNAL_TOP_SOURCE_DIR "@INTERNAL_TOP_SOURCE_DIR@")
if(NOT INTERNAL_TOP_BUILD_DIR)
  set(INTERNAL_TOP_BUILD_DIR "@CMAKE_BINARY_DIR@")
endif()
if(NOT INTERNAL_TOP_SOURCE_DIR)
  set(INTERNAL_TOP_SOURCE_DIR "@CMAKE_SOURCE_DIR@")
endif()
set(INTERNAL_BUILD_DIR "@CMAKE_CURRENT_BINARY_DIR@")
set(INTERNAL_SOURCE_DIR "@CMAKE_CURRENT_SOURCE_DIR@")
include(GeneralTools)
restore_spaces(ARGUMENTS)
message(DEBUG "EXTERNAL FUNCTION: ${MODULE}::${FUNCTION}(${ARGUMENTS}) [ID=${IDSTR}]")
if(MODULE)
  include(${MODULE})
endif()
@ARGS_FUNCTION@(${ARGUMENTS})
