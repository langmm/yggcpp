cmake_minimum_required(VERSION @CMAKE_MINIMUM_REQUIRED_VERSION@)
message(DEBUG "Checking for external language: @language@ (CMAKE_GENERATOR = ${CMAKE_GENERATOR}, LINKER_LANGUAGE = @ARGS_LINKER_LANGUAGE@)")
list(APPEND CMAKE_MODULE_PATH "@CMAKE_CURRENT_FUNCTION_LIST_DIR@")
include(GeneralTools)
show_build_info(PREFIX "CHECK EXTERNAL @target@: ")
project(check_language_@language@ LANGUAGES @language@ @ARGS_LINKER_LANGUAGE@)
show_build_info(PREFIX "CHECK EXTERNAL @target@: ")
set(LANGUAGE @language@)
set(OUTPUT_FILE "@foutput@")
set(COMPILER_VAR "CMAKE_${LANGUAGE}_COMPILER")
set(IMPLICIT_LIBRARIES_FILE "@fimplicitlibs@")
set(INTERNAL_MSVC @MSVC@)
set(OUTPUT_VARS @EXTERNAL_VARIABLES@)
# dump_cmake_variables(
#   VERBOSE PREFIX "CMAKE_"
#   EXCLUDE_PREFIX "CMAKE_${LANGUAGE}_"
# )
# dump_cmake_variables(
#   OUTPUT_VAR OUTPUT_VARS
#   VERBOSE PREFIX "CMAKE_${LANGUAGE}_"
# )

if(${COMPILER_VAR})
  message(STATUS "Located external compiler for ${LANGUAGE}")
  message(STATUS "${COMPILER_VAR} = ${${COMPILER_VAR}}")
  message(STATUS "CMAKE_GENERATOR = ${CMAKE_GENERATOR}")
  set(CONTENTS)
  dump_cmake_variables(
    OUTPUT_VAR CONTENTS
    OUTPUT_PATTERN "<key>=<value>"
    VARIABLES ${OUTPUT_VARS}
    VERBOSE  # LOG_LEVEL DEBUG
  )
  if(OUTPUT_FILE)
    message(STATUS "DUMPING VARS TO ${OUTPUT_FILE}:\n    ${CONTENTS}")
    file(WRITE ${OUTPUT_FILE} "${CONTENTS}")
  endif()
  if(IMPLICIT_LIBRARIES_FILE)
    message(STATUS "IMPLICIT_LIBRARIES_FILE = ${IMPLICIT_LIBRARIES_FILE}")
    include(AddTargetsFromFile)
    message(STATUS "CMAKE_${LANGUAGE}_COMPILER_ID = ${CMAKE_${LANGUAGE}_COMPILER_ID}")
    set(implicit_args LANGUAGE_ONLY)
    if(INTERNAL_MSVC AND CMAKE_${LANGUAGE}_COMPILER_ID STREQUAL "GNU")
      list(APPEND implicit_args FULL_LIBRARIES)  # CREATE_MSVC_IMPORT
    endif()
    generate_implicit_libraries_file(
      ${LANGUAGE} ${IMPLICIT_LIBRARIES_FILE}
      ${implicit_args}
    )
  else()
    message(STATUS "IMPLICIT_LIBRARIES_FILE not set")
  endif()
endif()
