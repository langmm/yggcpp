  if(CMAKE_CXX_COMPILER)
    message(STATUS "YggInterfaceConfig: LOCATED CMAKE_CXX_COMPILER = ${CMAKE_CXX_COMPILER}")
    message(STATUS "CMAKE_LINKER BEFORE ENABLE_LANGUAGE(CXX) = ${CMAKE_LINKER}")
    enable_language(CXX)
  endif()
  message(STATUS "CMAKE_CXX_COMPILER_ID = ${CMAKE_CXX_COMPILER_ID}")
  message(STATUS "CMAKE_CXX_COMPILER_WORKS = ${CMAKE_CXX_COMPILER_WORKS}")
  if(NOT CMAKE_CXX_COMPILER)
    message(FATAL_ERROR "CXX linker required for linking against YggInterface")
