include(CMakeFindDependencyMacro)
set(YGG_CMAKE_MODULE_DIR "@YGG_CMAKE_MODULE_DIR@")
cmake_path(
  ABSOLUTE_PATH YGG_CMAKE_MODULE_DIR
  BASE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}"
)
list(APPEND CMAKE_MODULE_PATH "${YGG_CMAKE_MODULE_DIR}")
include(AddYggInterface)
set(YGG_OPTIONS_SUPPORTED "@YGG_OPTIONS_SUPPORTED@")
set(YGG_COMMS_SUPPORTED "@YGG_COMMS_SUPPORTED@")
set(YGG_COMMS_AVAILABLE "@YGG_COMMS_AVAILABLE@")
set(YGG_LANGUAGES_SUPPORTED "@YGG_LANGUAGES_SUPPORTED@")
set(YGG_LANGUAGES_AVAILABLE "@YGG_LANGUAGES_AVAILABLE@")
set(YGG_INSTALL_DEPS "@YGG_INSTALL_DEPS@")
set(YGG_INSTALL_CONFIG "@YGG_INSTALL_CONFIG@")
set(YGG_GNU_FORTRAN_AND_MSVC OFF)

include(${YGG_CMAKE_MODULE_DIR}/YggInterfaceMacros.cmake)
ygginterface_options_import()

if((NOT CMAKE_CXX_COMPILER) AND
   CMAKE_Fortran_COMPILER_ID MATCHES "GNU" AND WIN32)
  message(STATUS "BEFORE check_language(CXX)")
  message(STATUS "CMAKE_LINKER_TYPE = ${CMAKE_LINKER_TYPE}")
  message(STATUS "CMAKE_LINKER = ${CMAKE_LINKER}")
  foreach(ilang C CXX Fortran)
    message(STATUS "CMAKE_${ilang}_COMPILER = ${CMAKE_${ilang}_COMPILER}")
    message(STATUS "CMAKE_${ilang}_COMPILER_LINKER = ${CMAKE_${ilang}_COMPILER_LINKER}")
    message(STATUS "CMAKE_${ilang}_LINK_EXECUTABLE = ${CMAKE_${ilang}_LINK_EXECUTABLE}")
    message(STATUS "CMAKE_${ilang}_LINKER_TYPE = ${CMAKE_${ilang}_LINKER_TYPE}")
  endforeach()
endif()
