if(CMAKE_Fortran_COMPILER_ID MATCHES "GNU" AND
   CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
  set(YGG_GNU_FORTRAN_AND_MSVC ON)
  message(STATUS "CMAKE_LINK_LIBRARY_SUFFIX = ${CMAKE_LINK_LIBRARY_SUFFIX}")
  foreach(ilang C CXX Fortran)
    message(STATUS "CMAKE_${ilang}_COMPILER = ${CMAKE_${ilang}_COMPILER}")
    message(STATUS "CMAKE_${ilang}_COMPILER_LINKER = ${CMAKE_${ilang}_COMPILER_LINKER}")
    message(STATUS "CMAKE_${ilang}_LINK_EXECUTABLE = ${CMAKE_${ilang}_LINK_EXECUTABLE}")
    message(STATUS "CMAKE_${ilang}_LINKER_TYPE = ${CMAKE_${ilang}_LINKER_TYPE}")
    message(STATUS "CMAKE_${ilang}_LINK_LIBRARY_SUFFIX = ${CMAKE_${ilang}_LINK_LIBRARY_SUFFIX}")
  endforeach()
  set(CMAKE_Fortran_LINK_EXECUTABLE "${CMAKE_CXX_LINK_EXECUTABLE}")
  set(CMAKE_Fortran_LINK_LIBRARY_SUFFIX "${CMAKE_CXX_LINK_LIBRARY_SUFFIX}")
endif()

foreach(dep IN LISTS YGG_INSTALL_DEPS)
  if (dep MATCHES "Python" OR
      dep STREQUAL "ZeroMQ" OR
      dep STREQUAL "rabbitmq-c" OR
      dep STREQUAL "CURL")
    find_yggdrasil_dependency(${dep} FOR_PACKAGE_CONFIG)
  else()
    find_dependency(${dep})
  endif()
endforeach()

include(${YGG_CMAKE_MODULE_DIR}/YggInterfaceTargets.cmake)

if (TARGET YggInterface::YggInterface)
  add_library(YggInterface::CXX ALIAS YggInterface::YggInterface)
  add_library(YggInterface::C ALIAS YggInterface::YggInterface)
endif()
if (TARGET YggInterface::YggInterface_fortran)
  add_library(YggInterface::Fortran ALIAS
              YggInterface::YggInterface_fortran)
endif()
set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} CACHE INTERNAL "CMAKE_MODULE_PATH")
