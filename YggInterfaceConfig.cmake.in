include(CMakeFindDependencyMacro)
list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})
include(AddYggInterface)
set(YGG_OPTIONS_SUPPORTED "@YGG_OPTIONS_SUPPORTED@")
set(YGG_COMMS_SUPPORTED "@YGG_COMMS_SUPPORTED@")
set(YGG_COMMS_AVAILABLE "@YGG_COMMS_AVAILABLE@")
set(YGG_LANGUAGES_SUPPORTED "@YGG_LANGUAGES_SUPPORTED@")
set(YGG_LANGUAGES_AVAILABLE "@YGG_LANGUAGES_AVAILABLE@")
set(YGG_INSTALL_DEPS "@YGG_INSTALL_DEPS@")
set(YGG_INSTALL_CONFIG "@YGG_INSTALL_CONFIG@")
set(YGG_GNU_FORTRAN_AND_MSVC OFF)

include(${CMAKE_CURRENT_LIST_DIR}/YggInterfaceMacros.cmake)
ygginterface_options_import()

# if((NOT CMAKE_CXX_COMPILER) AND
#    CMAKE_Fortran_COMPILER_ID MATCHES "GNU" AND WIN32)
#   check_language(CXX)
#   message(STATUS "YggInterfaceConfig: Checking for external CXX linker for use with GNU compiler on windows (MSVC=${MSVC}, CMAKE_CXX_COMPILER_ID=${CMAKE_CXX_COMPILER_ID})")
#   # include(${CMAKE_CURRENT_LIST_DIR}/BuildTools.cmake)
#   # enable_language_external(CXX)
#   # TODO: Set MSVC CXX linker for use with fortran
#   if(MSVC)
#     set(CMAKE_LINKER_TYPE)
#   endif()
# endif()
if(NOT CMAKE_CXX_COMPILER)
  include(CheckLanguage)
  check_language(CXX)
  if(CMAKE_Fortran_COMPILER_ID MATCHES "GNU" AND WIN32)
    message(STATUS "YggInterfaceConfig: Checking for external CXX linker for use with GNU compiler on windows (MSVC=${MSVC}, CMAKE_CXX_COMPILER_ID=${CMAKE_CXX_COMPILER_ID})")
    if(CMAKE_CXX_COMPILER MATCHES "cl\\.exe")
      message(STATUS "Setting CMAKE_LINKER_TYPE to MSVC (previously CMAKE_LINKER_TYPE=${CMAKE_LINKER_TYPE}, CMAKE_CXX_LINKER_TYPE=${CMAKE_CXX_LINKER_TYPE}, CMAKE_Fortran_LINKER_TYPE=${CMAKE_Fortran_LINKER_TYPE})")
      set(CMAKE_CXX_LINKER_TYPE MSVC)
      set(CMAKE_Fortran_LINKER_TYPE MSVC)
      set(CMAKE_LINKER_TYPE MSVC)
      cmake_path(GET CMAKE_CXX_COMPILER PARENT_PATH MSVC_BIN_PATH)
      foreach(ilang C CXX Fortran)
        set(CMAKE_${ilang}_LINKER_TYPE MSVC)
      endforeach()
      cmake_path(
        APPEND MSVC_BIN_PATH "link.exe"
        OUTPUT_VARIABLE CMAKE_LINKER
      )
    endif()
  endif()
  if(CMAKE_CXX_COMPILER)
    message(STATUS "YggInterfaceConfig: LOCATED CMAKE_CXX_COMPILER = ${CMAKE_CXX_COMPILER}")
    enable_language(CXX)
  endif()
  message(STATUS "CMAKE_CXX_COMPILER_WORKS = ${CMAKE_CXX_COMPILER_WORKS}")
  if(NOT CMAKE_CXX_COMPILER)
    message(FATAL_ERROR "CXX linker required for linking against YggInterface")
  endif()
endif()
if(CMAKE_Fortran_COMPILER_ID MATCHES "GNU" AND
   CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
  set(YGG_GNU_FORTRAN_AND_MSVC ON)
  set(CMAKE_LINKER "link")
endif()

foreach(dep IN LISTS YGG_INSTALL_DEPS)
  if (dep MATCHES "Python" OR
      dep STREQUAL "ZeroMQ" OR
      dep STREQUAL "rabbitmq-c" OR
      dep STREQUAL "CURL")
    find_yggdrasil_dependency(${dep} FOR_PACKAGE_CONFIG)
  else()
    find_dependency(${dep})
  endif()
endforeach()

include(${CMAKE_CURRENT_LIST_DIR}/YggInterfaceTargets.cmake)

if (TARGET YggInterface::YggInterface)
  add_library(YggInterface::CXX ALIAS YggInterface::YggInterface)
  add_library(YggInterface::C ALIAS YggInterface::YggInterface)
endif()
if (TARGET YggInterface::YggInterface_fortran)
  add_library(YggInterface::Fortran ALIAS
              YggInterface::YggInterface_fortran)
endif()
set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} CACHE INTERNAL "CMAKE_MODULE_PATH")
