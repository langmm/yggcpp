include(CMakeFindDependencyMacro)
set(YGG_CMAKE_MODULE_DIR "@YGG_CMAKE_MODULE_DIR@")
cmake_path(
  ABSOLUTE_PATH YGG_CMAKE_MODULE_DIR
  BASE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}"
)
list(APPEND CMAKE_MODULE_PATH "${YGG_CMAKE_MODULE_DIR}")
include(AddYggInterface)
set(YGG_OPTIONS_SUPPORTED "@YGG_OPTIONS_SUPPORTED@")
set(YGG_COMMS_SUPPORTED "@YGG_COMMS_SUPPORTED@")
set(YGG_COMMS_AVAILABLE "@YGG_COMMS_AVAILABLE@")
set(YGG_LANGUAGES_SUPPORTED "@YGG_LANGUAGES_SUPPORTED@")
set(YGG_LANGUAGES_AVAILABLE)
set(YGG_INSTALL_DEPS "@YGG_INSTALL_DEPS@")
set(YGG_INSTALL_CONFIG "@YGG_INSTALL_CONFIG@")
set(YGG_Fortran_GNU_AND_MSVC OFF)
set(YGG_Fortran_LINKS_TO_CXX OFF)
set(YGG_TARGET_CXX "@YGG_TARGET_CXX@")
set(YGG_TARGET_Fortran "@YGG_TARGET_Fortran@")

include(${YGG_CMAKE_MODULE_DIR}/YggInterfaceMacros.cmake)
ygginterface_options_import()

include(${YGG_CMAKE_MODULE_DIR}/YggInterfaceTargets.cmake)

if(TARGET YggInterface::${YGG_TARGET_Fortran})
  list(APPEND YGG_LANGUAGES_AVAILABLE Fortran)
  if(CMAKE_Fortran_COMPILER_LOADED)
    add_library(YggInterface::Fortran ALIAS
                YggInterface::${YGG_TARGET_Fortran})
    get_target_property(
      YGG_Fortran_TARGET_DEFS YggInterface::${YGG_TARGET_Fortran}
      INTERFACE_COMPILE_DEFINITIONS
    )
    get_target_property(
      YGG_Fortran_TARGET_LIBS YggInterface::${YGG_TARGET_Fortran}
      INTERFACE_LINK_LIBRARIES
    )
    message(STATUS "YGG_Fortran_TARGET_DEFS = ${YGG_Fortran_TARGET_DEFS}")
    message(STATUS "YGG_Fortran_TARGET_LIBS = ${YGG_Fortran_TARGET_LIBS}")
    if("-DYGG_Fortran_GNU_AND_MSVC" IN_LIST YGG_Fortran_TARGET_DEFS)
      set(YGG_Fortran_GNU_AND_MSVC ON)
    endif()
    if("YggInterface" IN_LIST YGG_Fortran_TARGET_LIBS)
      set(YGG_Fortran_LINKS_TO_CXX ON)
    endif()
    unset(YGG_Fortran_TARGET_DEFS)
    unset(YGG_Fortran_TARGET_LIBS)
    if(YGG_Fortran_GNU_AND_MSVC AND NOT CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
      message(FATAL_ERROR "YggInterface::${YGG_TARGET_Fortran} was built using a mix of GNU & MSVC which requires the GNU fortran compiler & MSVC CXX linker")
    endif()
  endif()
endif()
if(TARGET YggInterface::${YGG_TARGET_CXX})
  list(APPEND YGG_LANGUAGES_AVAILABLE CXX C)
  if(CMAKE_C_COMPILER_LOADED OR CMAKE_CXX_COMPILER_LOADED OR
     YGG_Fortran_LINKS_TO_CXX)
    # TODO: Check linker?
    add_library(YggInterface::CXX ALIAS YggInterface::${YGG_TARGET_CXX})
    add_library(YggInterface::C ALIAS YggInterface::${YGG_TARGET_CXX})
  endif()
endif()
find_yggdrasil_dependency(Python FOR_PACKAGE_CONFIG)
if(Python3_EXECUTABLE)
  execute_process(
    COMMAND ${Python3_EXECUTABLE} -c "import YggInterface"
    RESULT_VARIABLE Python_RET
  )
  if(Python_RET EQUAL 0)
    list(APPEND YGG_LANGUAGES_AVAILABLE Python)
  endif()
endif()
message(STATUS "YGG_Fortran_GNU_AND_MSVC = ${YGG_Fortran_GNU_AND_MSVC}")
message(STATUS "YGG_Fortran_LINKS_TO_CXX = ${YGG_Fortran_LINKS_TO_CXX}")

if((NOT CMAKE_CXX_COMPILER) AND YGG_Fortran_GNU_AND_MSVC AND
   CMAKE_Fortran_COMPILER_ID MATCHES "GNU" AND WIN32)
  message(STATUS "BEFORE check_language(CXX)")
  message(STATUS "CMAKE_LINKER_TYPE = ${CMAKE_LINKER_TYPE}")
  message(STATUS "CMAKE_LINKER = ${CMAKE_LINKER}")
  message(STATUS "CMAKE_LINK_LIBRARY_SUFFIX = ${CMAKE_LINK_LIBRARY_SUFFIX}")
  message(STATUS "CMAKE_FIND_LIBRARY_SUFFIXES = ${CMAKE_FIND_LIBRARY_SUFFIXES}")
  message(STATUS "CMAKE_FIND_LIBRARY_PREFIXES = ${CMAKE_FIND_LIBRARY_PREFIXES}")
  foreach(k SHARED STATIC IMPORT)
    message(STATUS "CMAKE_${k}_LIBRARY_PREFIX = ${CMAKE_${k}_LIBRARY_PREFIX}")
    message(STATUS "CMAKE_${k}_LIBRARY_SUFFIX = ${CMAKE_${k}_LIBRARY_SUFFIX}")
  endforeach()
  foreach(ilang C CXX Fortran)
    message(STATUS "CMAKE_${ilang}_COMPILER = ${CMAKE_${ilang}_COMPILER}")
    message(STATUS "CMAKE_${ilang}_COMPILER_LINKER = ${CMAKE_${ilang}_COMPILER_LINKER}")
    message(STATUS "CMAKE_${ilang}_LINK_EXECUTABLE = ${CMAKE_${ilang}_LINK_EXECUTABLE}")
    message(STATUS "CMAKE_${ilang}_LINKER_TYPE = ${CMAKE_${ilang}_LINKER_TYPE}")
  endforeach()
endif()
if(YGG_Fortran_GNU_AND_MSVC AND NOT (CMAKE_LINKER MATCHES "link\\.exe"))
  message(STATUS "Ensuring MSVC linker CMAKE_LINKER = ${CMAKE_LINKER}")
  message(STATUS "CMAKE_LINKER_LINK = ${CMAKE_LINKER_LINK}")
  include(${YGG_CMAKE_MODULE_DIR}/BuildTools.cmake)
  check_language_external(
    CXX OUTPUT_COMPILER EXTERNAL_COMPILER
    OUTPUT_LINKER EXTERNAL_LINKER
  )
  message(STATUS "CXX_EXTERNAL_COMPILER = ${EXTERNAL_COMPILER}")
  message(STATUS "CXX_EXTERNAL_LINKER = ${EXTERNAL_LINKER}")
  set(CMAKE_LINKER "${EXTERNAL_LINKER}")
  set(CMAKE_LINKER_LINK "${EXTERNAL_LINKER}")
endif()
if(NOT CMAKE_CXX_COMPILER)
  # CXX must be enabled to locate C++ dependencies
  message(STATUS "CMAKE_LINKER BEFORE ENABLE_LANGUAGE(CXX) = ${CMAKE_LINKER}")
  enable_language(CXX)
  message(STATUS "CMAKE_CXX_COMPILER_ID = ${CMAKE_CXX_COMPILER_ID}")
endif()
if(YGG_Fortran_GNU_AND_MSVC AND NOT (CMAKE_LINKER MATCHES "link\\.exe"))
  message(FATAL_ERROR "MSVC linker required for linking against Fortran interface target YggInterface::${YGG_TARGET_Fortran} (CMAKE_LINKER = ${CMAKE_LINKER})")
endif()
if(YGG_Fortran_GNU_AND_MSVC)
  if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    message(FATAL_ERROR "MSVC linker required for linking against Fortran interface target YggInterface::${YGG_TARGET_Fortran} (CMAKE_CXX_COMPILER_ID = ${CMAKE_CXX_COMPILER_ID})")
  endif()
  foreach(ilang C CXX Fortran)
    message(STATUS "CMAKE_${ilang}_COMPILER = ${CMAKE_${ilang}_COMPILER}")
    message(STATUS "CMAKE_${ilang}_COMPILER_LINKER = ${CMAKE_${ilang}_COMPILER_LINKER}")
    message(STATUS "CMAKE_${ilang}_LINK_EXECUTABLE = ${CMAKE_${ilang}_LINK_EXECUTABLE}")
    message(STATUS "CMAKE_${ilang}_LINKER_TYPE = ${CMAKE_${ilang}_LINKER_TYPE}")
    message(STATUS "CMAKE_${ilang}_LINK_LIBRARY_SUFFIX = ${CMAKE_${ilang}_LINK_LIBRARY_SUFFIX}")
    message(STATUS "CMAKE_${ilang}_IMPLICIT_LINK_LIBRARIES = ${CMAKE_${ilang}_IMPLICIT_LINK_LIBRARIES}")
    message(STATUS "CMAKE_${ilang}_IMPLICIT_LINK_DIRECTORIES = ${CMAKE_${ilang}_IMPLICIT_LINK_DIRECTORIES}")
    message(STATUS "CMAKE_${ilang}_STANDARD_LIBRARIES = ${CMAKE_${ilang}_STANDARD_LIBRARIES}")
    message(STATUS "CMAKE_${ilang}_STANDARD_LIBRARIES_INIT = ${CMAKE_${ilang}_STANDARD_LIBRARIES_INIT}")
  endforeach()
  if(NOT CMAKE_CXX_LINK_LIBRARY_SUFFIX)
    set(CMAKE_CXX_LINK_LIBRARY_SUFFIX ".lib")
  endif()
  set(CMAKE_Fortran_LINK_EXECUTABLE "${CMAKE_CXX_LINK_EXECUTABLE}")
  set(CMAKE_Fortran_LINK_LIBRARY_SUFFIX "${CMAKE_CXX_LINK_LIBRARY_SUFFIX}")
  set(CMAKE_LINK_LIBRARY_SUFFIX "${CMAKE_CXX_LINK_LIBRARY_SUFFIX}")
endif()

if(YGG_Fortran_GNU_AND_MSVC)
  include(${YGG_CMAKE_MODULE_DIR}/BuildTools.cmake)
  get_implicit_libraries(
    Fortran GNU_Fortran_IMPLICIT_LINK_LIBRARIES
    LANGUAGE_ONLY
      FULL_LIBRARIES
  )
  set(MSVC_CXX_STANDARD_LIBRARIES ${CMAKE_CXX_STANDARD_LIBRARIES})
  message(STATUS "GNU_Fortran_IMPLICIT_LINK_LIBRARIES = ${GNU_Fortran_IMPLICIT_LINK_LIBRARIES}")
  message(STATUS "MSVC_CXX_STANDARD_LIBRARIES = ${MSVC_CXX_STANDARD_LIBRARIES}")
  # set(is_exec "$<STREQUAL:$<TARGET_PROPERTY:TYPE>,EXECUTABLE>")
  # target_compile_options(
  #   YggInterface::${YGG_TARGET_Fortran} INTERFACE
  #   "$<${is_exec}:-mconsole>"
  # )
  # target_link_options(
  #   YggInterface::${YGG_TARGET_Fortran} INTERFACE
  #   "$<${is_exec}:/SUBSYSTEM:CONSOLE>"
  #   "$<${is_exec}:/ENTRY:mainCRTStartup>"
  # )
  target_link_libraries(
    YggInterface::${YGG_TARGET_Fortran} INTERFACE
    ${GNU_Fortran_IMPLICIT_LINK_LIBRARIES}
    ${MSVC_CXX_STANDARD_LIBRARIES}
    $<IF:$<CONFIG:Debug>,ucrtd,ucrt>
    $<IF:$<CONFIG:Debug>,msvcrtd,msvcrt>
    $<IF:$<CONFIG:Debug>,vcruntimed,vcruntime>
  )
  target_link_directories(
    YggInterface::${YGG_TARGET_Fortran} INTERFACE
    ${CMAKE_Fortran_IMPLICIT_LINK_DIRECTORIES}
  )
endif()

foreach(dep IN LISTS YGG_INSTALL_DEPS)
  if (dep MATCHES "Python" OR
      dep STREQUAL "ZeroMQ" OR
      dep STREQUAL "rabbitmq-c" OR
      dep STREQUAL "CURL")
    find_yggdrasil_dependency(${dep} FOR_PACKAGE_CONFIG)
  else()
    find_dependency(${dep})
  endif()
endforeach()

set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} CACHE INTERNAL "CMAKE_MODULE_PATH")
