include(CMakeFindDependencyMacro)
set(YGG_CMAKE_MODULE_DIR "@YGG_CMAKE_MODULE_DIR@")
cmake_path(
  ABSOLUTE_PATH YGG_CMAKE_MODULE_DIR
  BASE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}"
)
list(APPEND CMAKE_MODULE_PATH "${YGG_CMAKE_MODULE_DIR}")
include(AddYggInterface)
set(YGG_OPTIONS_SUPPORTED "@YGG_OPTIONS_SUPPORTED@")
set(YGG_COMMS_SUPPORTED "@YGG_COMMS_SUPPORTED@")
set(YGG_COMMS_AVAILABLE "@YGG_COMMS_AVAILABLE@")
set(YGG_LANGUAGES_SUPPORTED "@YGG_LANGUAGES_SUPPORTED@")
set(YGG_LANGUAGES_AVAILABLE)
set(YGG_INSTALL_DEPS "@YGG_INSTALL_DEPS@")
set(YGG_INSTALL_CONFIG "@YGG_INSTALL_CONFIG@")
set(YGG_Fortran_GNU_AND_MSVC OFF)
set(YGG_Fortran_LINKS_TO_CXX OFF)
set(YGG_TARGET_CXX "@YGG_TARGET_CXX@")
set(YGG_TARGET_Fortran "@YGG_TARGET_Fortran@")

include(${YGG_CMAKE_MODULE_DIR}/YggInterfaceMacros.cmake)
ygginterface_options_import()

include(${YGG_CMAKE_MODULE_DIR}/YggInterfaceTargets.cmake)

if(TARGET YggInterface::${YGG_TARGET_Fortran})
  list(APPEND YGG_LANGUAGES_AVAILABLE Fortran)
  if(CMAKE_Fortran_COMPILER_LOADED)
    add_library(YggInterface::Fortran ALIAS
                YggInterface::${YGG_TARGET_Fortran})
    get_target_property(
      YGG_Fortran_TARGET_DEFS YggInterface::${YGG_TARGET_Fortran}
      INTERFACE_COMPILE_DEFINITIONS
    )
    get_target_property(
      YGG_Fortran_TARGET_LIBS YggInterface::${YGG_TARGET_Fortran}
      INTERFACE_LINK_LIBRARIES
    )
    message(STATUS "YGG_Fortran_TARGET_DEFS = ${YGG_Fortran_TARGET_DEFS}")
    message(STATUS "YGG_Fortran_TARGET_LIBS = ${YGG_Fortran_TARGET_LIBS}")
    if("YGG_Fortran_GNU_AND_MSVC" IN_LIST YGG_Fortran_TARGET_DEFS)
      set(YGG_Fortran_GNU_AND_MSVC ON)
    endif()
    if("YggInterface" IN_LIST YGG_Fortran_TARGET_LIBS)
      set(YGG_Fortran_LINKS_TO_CXX ON)
    endif()
    unset(YGG_Fortran_TARGET_DEFS)
    unset(YGG_Fortran_TARGET_LIBS)
    if(YGG_Fortran_GNU_AND_MSVC AND NOT CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
      message(FATAL_ERROR "YggInterface::${YGG_TARGET_Fortran} was built using a mix of GNU & MSVC which requires the GNU fortran compiler & MSVC CXX linker")
    endif()
  endif()
endif()
if(TARGET YggInterface::${YGG_TARGET_CXX})
  list(APPEND YGG_LANGUAGES_AVAILABLE CXX C)
  if(CMAKE_C_COMPILER_LOADED OR CMAKE_CXX_COMPILER_LOADED OR
     YGG_Fortran_LINKS_TO_CXX)
    # TODO: Check linker?
    add_library(YggInterface::CXX ALIAS YggInterface::${YGG_TARGET_CXX})
    add_library(YggInterface::C ALIAS YggInterface::${YGG_TARGET_CXX})
  endif()
endif()
find_yggdrasil_dependency(Python FOR_PACKAGE_CONFIG)
if(Python3_EXECUTABLE)
  execute_process(
    COMMAND ${Python3_EXECUTABLE} -c "import YggInterface"
    RESULT_VARIABLE CHECK_Python_RET
    OUTPUT_VARIABLE CHECK_Python_OUTPUT
    ERROR_VARIABLE CHECK_Python_OUTPUT
  )
  if(CHECK_Python_RET EQUAL 0)
    list(APPEND YGG_LANGUAGES_AVAILABLE Python)
  endif()
endif()
message(STATUS "YGG_Fortran_GNU_AND_MSVC = ${YGG_Fortran_GNU_AND_MSVC}")
message(STATUS "YGG_Fortran_LINKS_TO_CXX = ${YGG_Fortran_LINKS_TO_CXX}")

foreach(dep IN LISTS YGG_INSTALL_DEPS)
  if (dep MATCHES "Python" OR
      dep STREQUAL "ZeroMQ" OR
      dep STREQUAL "rabbitmq-c" OR
      dep STREQUAL "CURL")
    find_yggdrasil_dependency(${dep} FOR_PACKAGE_CONFIG)
  else()
    find_dependency(${dep})
  endif()
endforeach()

set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} CACHE INTERNAL "CMAKE_MODULE_PATH")
