cmake_minimum_required(VERSION 3.18)

# compile in release with debug info mode by default
if(NOT CMAKE_BUILD_TYPE)
  # This must be before the project call or the default Debug value used
  # by the Ninja generator will be used
  # https://discourse.cmake.org/t/how-to-deal-with-ninja-setting-cmake-build-type-to-debug/281
  set(CMAKE_BUILD_TYPE "RelWithDebInfo" CACHE STRING "Choose the type of build, options are: Debug Release RelWithDebInfo MinSizeRel." FORCE)
endif()
message(STATUS "CMAKE_BUILD_TYPE = ${CMAKE_BUILD_TYPE}")

set(LANG @LANGUAGE@)
project(SpeedTest@LANGUAGE@ @LANGUAGE@)

option(YGG_INSPECT_TARGETS "Inspect the executables and libraries that are built" OFF)

find_package(YggInterface REQUIRED)

add_executable(speedtest_@LANGUAGE@ speedtest.@LANGUAGE_EXT@)
target_link_libraries(speedtest_@LANGUAGE@ PRIVATE
                      YggInterface::@LANGUAGE@)
if(YGG_INSPECT_TARGETS)
  include(CheckDLL)
  show_runtimes(speedtest_@LANGUAGE@)
endif()
