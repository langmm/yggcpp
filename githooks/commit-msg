#!/bin/sh
#
# Enforce Conventional Commits (https://www.conventionalcommits.org)
# Format: <type>[optional scope][!]: <description>
#
# Enable by running `git config core.hooksPath githooks`
# (or `pixi run setup-hooks`).

commit_msg_file="$1"

# # Ignore merge and revert commits generated by git.
# first_line=$(sed -n '1p' "$commit_msg_file")
# case "$first_line" in
#     "Merge "*|"merge "*|"Revert "*|"revert "*)
#         exit 0
#         ;;
# esac

# # Strip comments (lines starting with #) and trailing blank lines.
# cleaned=$(grep -v '^#' "$commit_msg_file" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')

# if [ -z "$cleaned" ]; then
#     echo "commit-msg: empty commit message" >&2
#     exit 1
# fi

# header=$(printf '%s\n' "$cleaned" | sed -n '1p')

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|ignore'
pattern="^($types)(\([a-zA-Z0-9._/-]+\))?!?: .*$"
FAILED=0
LINE_NUM=0

# Read the commit message file line by line
while IFS= read -r line || [[ -n "$line" ]]; do
  LINE_NUM=$((LINE_NUM + 1))

  # 1. Skip standard Git comment lines (e.g., "# Please enter the commit message...")
  if [[ "$line" =~ ^# ]]; then
    continue
  fi

  # 2. Skip empty lines (blank line separators are allowed/encouraged in Git)
  if [[ -z "$(echo "$line" | xargs)" ]]; then
    continue
  fi

  # 3. Match line against the conventional commit pattern
  if ! [[ "$line" =~ $pattern ]]; then
    echo -e "\033[31m[INVALID COMMIT FORMAT] Line $LINE_NUM does not follow Conventional Commits rules:\033[0m"
    echo -e "  -> \"$line\""
    FAILED=1
  fi
done < "$commit_msg_file"

if [ "$FAILED" -eq 1 ]; then
    cat >&2 <<EOF
commit-msg: commit message does not follow Conventional Commits.

  <type>[optional scope][!]: <description>

  type: one of $types
  scope: optional, e.g. (parser), (docs), (ci)
  !:     optional, marks a breaking change
  description: short summary (start with a letter, e.g. lowercase)

Examples:
  feat(parser): add support for anchors
  fix: handle empty input without crashing
  docs(readme): update build instructions
  refactor!: drop deprecated API

Your message was:
  $header
EOF
    exit 1
fi

exit 0
